# ============================================================================
# Airtrohp FRONTEND environment (Vercel -> Project Settings -> Environment Variables)
# Everything prefixed VITE_ is bundled into public JavaScript. Never put secrets here.
# Firebase web config values are public identifiers by design (access is enforced by
# Firestore security rules + the Worker), but they are still read from env so you can swap projects.
# ============================================================================

# URL of your deployed Cloudflare Worker (no trailing slash)
VITE_API_URL=https://airtrohp-api.your-subdomain.workers.dev

# Firebase console -> Project settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ============================================================================
# BACKEND SECRETS: NOT set here. They live ONLY in Cloudflare (never in Git, never in Vercel):
#
#   wrangler secret put GEMINI_API_KEY               # Google AI Studio key
#   wrangler secret put FIREBASE_SERVICE_ACCOUNT     # full service-account JSON (one line)
#   wrangler secret put APP_SECRET                   # 32+ random characters
#   wrangler secret put PATREON_CLIENT_ID
#   wrangler secret put PATREON_CLIENT_SECRET
#   wrangler secret put PATREON_WEBHOOK_SECRET
#   wrangler secret put ADMIN_UIDS                   # comma separated Firebase UIDs of admins
#
# For local Worker development copy worker/.dev.vars.example to worker/.dev.vars (git-ignored).
# ============================================================================
